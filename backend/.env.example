# Copy this file to ".env" (same folder) and fill in your own values.
# Never upload .env to GitHub (it is in .gitignore).

# Supabase: project home -> Connect -> Session pooler -> URI (put your database password in it)
DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Groq: https://console.groq.com/keys
LLM_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
# Optional
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b

# Which websites may call the backend (your Next.js site). Comma separated.
ALLOWED_ORIGINS=http://localhost:3000
